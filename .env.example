# Local preview with a sample catalog and persistent data in .data/demo.json.
# Set to false to use MongoDB Atlas and live TMDB search. Restart after changes.
DEMO_MODE=true
MONGODB_URI=
MONGODB_DATABASE=commune_movie_tracker
# TMDB API Read Access Token (not the numeric API key)
TMDB_READ_ACCESS_TOKEN=
# Required for a deployed Node server; local Vite development sets its own origin.
# ORIGIN=https://your-app.onrender.com
